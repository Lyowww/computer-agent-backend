# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/computer_agent?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# AI Service
AI_SERVICE_URL=http://localhost:4000
AI_SERVICE_TIMEOUT_MS=30000
AI_SERVICE_API_KEY=

# Security / limits
MAX_TASK_ITERATIONS=50
CONNECTION_TIMEOUT_MS=60000
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100
WS_RATE_LIMIT_MAX=30

# Screenshots (do not permanently store by default)
STORE_SCREENSHOTS=false
SCREENSHOT_TTL_SECONDS=60

# Device tokens
DEVICE_TOKEN_BYTES=32
